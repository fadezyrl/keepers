# Copy to android/keystore.properties (gitignored) and fill in real values.
# Generate a keystore (run from android/):
#   keytool -genkeypair -v -storetype PKCS12 -keystore app/keepers-upload.keystore -alias keepers-upload -keyalg RSA -keysize 2048 -validity 10000
#
# Back up the .keystore file and these passwords offline. Losing them blocks Play updates.

storeFile=app/keepers-upload.keystore
storePassword=REPLACE_STORE_PASSWORD
keyAlias=keepers-upload
keyPassword=REPLACE_KEY_PASSWORD
